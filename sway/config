# vim: ft=swayconfig
#
# Sway config. Read `man 5 sway` for a complete reference.

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left  h
set $down  j
set $up    k
set $right l

set $term kitty
set $menu fuzzel
# rofi alternative (config in ~/.config/rofi/config.rasi):
# set $menu rofi -show drun
set $filemanager nautilus
set $browser firefox
set $lock ~/.config/sway/lock.sh

### Output configuration
#
#output * bg /home/m/.config/arch-hero-wallpaper-free.png fill
output eDP-1 {
    resolution 1920x1080
    position 0,0
    scale 1.25
}

### Idle configuration
#
# Lock after 5 minutes, turn the screen off after 10, and lock before sleep.
exec swayidle -w \
         timeout 300 '$lock' \
         timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
         before-sleep '$lock'

### Autostart
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec $HOME/.config/mako/battery.sh
exec waybar -b 1

# Notifications: swaync (config in ~/.config/swaync; bell in waybar opens the panel)
exec swaync

# Clipboard history (cliphist): record text and images
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store

### Input configuration
#
# Read `man 5 sway-input` for more information about this section.
input type:touchpad {
    dwt enabled
    tap enabled
    natural_scroll enabled
    accel_profile adaptive
    scroll_factor 1.5
    pointer_accel 0.1
    drag disabled
}

input type:keyboard {
    xkb_layout "us,cz"
    xkb_options "altwin:prtsc_rwin"
    repeat_delay 200
    repeat_rate 30
}

### Window defaults
default_border pixel 2
gaps inner 1
gaps outer 2
titlebar_border_thickness 0
client.focused          #15439e #000000 #e0e0e0 #2e9ef4 #15439e
client.focused_inactive #595959 #000000 #e0e0e0 #2e9ef4 #595959
client.unfocused        #595959 #000000 #e0e0e0 #2e9ef4 #595959
# base16 colors from tinty override the lines above (tinted-theming/conf9000-templates)
include ~/.local/share/tinted-theming/tinty/artifacts/sway-sway-file.conf

# Idle inhibit for fullscreen windows
for_window [all] inhibit_idle fullscreen
for_window [title="^Authentication Required$"] floating enable
for_window [shell="xwayland"] title_format "[XWayland] %title"
# Bluetooth / network menus from waybar (right-click): drop down under the bar like the calendar.
# Centered on the cursor (clamped to the screen edge), pushed below the bar; size comes from kitty.
# waybar/scripts/dropdown.sh then aligns the top exactly to the bar's bottom edge.
for_window [app_id="bt-menu"] floating enable, border none, move position cursor, move down 42 px
for_window [app_id="nm-menu"] floating enable, border none, move position cursor, move down 42 px

### Key bindings
#
# Basics:
    bindsym $mod+Return exec $term
    bindsym $mod+Space exec $menu
    bindsym $mod+Shift+e exec $filemanager
    bindsym $mod+Shift+f exec $browser

    # Clipboard history: pick (fuzzel), delete one entry, wipe all
    bindsym $mod+Shift+v exec ~/.config/sway/clipboard.sh
    bindsym $mod+Ctrl+v exec ~/.config/sway/clipboard.sh delete
    bindsym $mod+Ctrl+Shift+v exec ~/.config/sway/clipboard.sh wipe
    # rofi alternative:
    # bindsym $mod+Shift+v exec ~/.config/sway/clipboard.sh rofi

    # Kill focused window / every window on this workspace
    bindsym $mod+q kill
    bindsym $mod+Ctrl+Backspace [workspace=__focused__] kill

    # Drag floating windows with $mod + left mouse, resize with $mod + right mouse.
    floating_modifier $mod normal

    bindsym $mod+Shift+c reload
    bindsym $mod+Ctrl+q exec $lock

    # Exit sway (logs you out of your Wayland session)
    bindsym $mod+Shift+x exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

# Moving around:
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    bindsym $mod+Ctrl+$left move left
    bindsym $mod+Ctrl+$down move down
    bindsym $mod+Ctrl+$up move up
    bindsym $mod+Ctrl+$right move right
    bindsym $mod+Ctrl+Left move left
    bindsym $mod+Ctrl+Down move down
    bindsym $mod+Ctrl+Up move up
    bindsym $mod+Ctrl+Right move right

    # Focus other monitors
    bindsym $mod+Shift+$left focus output left
    bindsym $mod+Shift+$down focus output down
    bindsym $mod+Shift+$up focus output up
    bindsym $mod+Shift+$right focus output right

# Workspaces:
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    bindsym $mod+0 workspace number 10
    # Move focused container to workspace and follow it
    bindsym $mod+Shift+1 move container to workspace number 1; workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2; workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3; workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4; workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5; workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6; workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7; workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8; workspace number 8
    bindsym $mod+Shift+9 move container to workspace number 9; workspace number 9
    bindsym $mod+Shift+0 move container to workspace number 10; workspace number 10

    bindsym $mod+Ctrl+1 move workspace to output left
    bindsym $mod+Ctrl+2 move workspace to output right

    bindsym $mod+Shift+Page_Up workspace prev
    bindsym $mod+Shift+Page_Down workspace next
    bindsym $mod+Page_Up workspace prev_on_output
    bindsym $mod+Page_Down workspace next_on_output
    bindsym $mod+Tab workspace back_and_forth
    bindsym $mod+Ctrl+z workspace back_and_forth

    bindgesture swipe:4:right workspace next
    bindgesture swipe:4:left workspace prev

# Output scaling (sway has no per-workspace zoom; this changes the whole screen)
    bindsym $mod+Shift+comma output eDP-1 scale 1
    bindsym $mod+Shift+period output eDP-1 scale 1.5
    bindsym $mod+Shift+Ctrl+period output eDP-1 scale 1.25

# Layout:
    # Split direction for the next window
    bindsym $mod+bracketleft splith
    bindsym $mod+bracketright splitv

    bindsym $mod+s layout stacking
    bindsym $mod+w layout tabbed
    bindsym $mod+e layout toggle split

    bindsym $mod+f fullscreen
    bindsym $mod+Ctrl+f fullscreen global

    # Float a window / switch focus between tiling and floating
    bindsym $mod+v floating toggle
    bindsym $mod+y focus mode_toggle

    bindsym $mod+a focus parent
    bindsym $mod+Shift+a focus child
    bindsym $mod+Shift+Ctrl+a sticky toggle

# Scratchpad:
    bindsym $mod+Shift+z move scratchpad
    bindsym $mod+z scratchpad show

# Resizing:
    bindsym $mod+minus resize shrink width 10ppt
    bindsym $mod+equal resize grow width 10ppt
    bindsym $mod+Shift+minus resize shrink height 10ppt
    bindsym $mod+Shift+equal resize grow height 10ppt

    mode "resize" {
        bindsym $left resize shrink width 100px
        bindsym $down resize grow height 100px
        bindsym $up resize shrink height 100px
        bindsym $right resize grow width 100px
        bindsym Escape mode "default"
        bindsym Return mode "default"
    }
    bindsym $mod+Shift+r mode "resize"

    # Set width/height to a fraction of the screen
    mode "setsizeh" {
        bindsym 1 resize set width 12 ppt; mode default
        bindsym 2 resize set width 17 ppt; mode default
        bindsym 3 resize set width 25 ppt; mode default
        bindsym 4 resize set width 33 ppt; mode default
        bindsym 5 resize set width 38 ppt; mode default
        bindsym 6 resize set width 50 ppt; mode default
        bindsym 7 resize set width 62 ppt; mode default
        bindsym 8 resize set width 67 ppt; mode default
        bindsym 9 resize set width 75 ppt; mode default
        bindsym 0 resize set width 83 ppt; mode default
        bindsym Escape mode "default"
    }
    bindsym $mod+b mode "setsizeh"

    mode "setsizev" {
        bindsym 1 resize set height 12 ppt; mode default
        bindsym 2 resize set height 17 ppt; mode default
        bindsym 3 resize set height 25 ppt; mode default
        bindsym 4 resize set height 33 ppt; mode default
        bindsym 5 resize set height 38 ppt; mode default
        bindsym 6 resize set height 50 ppt; mode default
        bindsym 7 resize set height 62 ppt; mode default
        bindsym 8 resize set height 67 ppt; mode default
        bindsym 9 resize set height 75 ppt; mode default
        bindsym 0 resize set height 83 ppt; mode default
        bindsym Escape mode "default"
    }
    bindsym $mod+Shift+b mode "setsizev"

# Utilities:
    # Volume (PulseAudio/PipeWire)
    bindsym --locked XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle && $HOME/.config/mako/volume.sh
    bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5% && $HOME/.config/mako/volume.sh
    bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5% && $HOME/.config/mako/volume.sh
    bindsym --locked XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle

    # Media
    bindsym --locked XF86AudioPlay exec playerctl play-pause
    bindsym --locked XF86AudioPause exec playerctl play-pause
    bindsym --locked XF86AudioPrev exec playerctl previous
    bindsym --locked XF86AudioNext exec playerctl next
    bindsym --locked XF86AudioStop exec playerctl stop

    # Brightness
    bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%- && $HOME/.config/mako/brightness.sh
    bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+ && $HOME/.config/mako/brightness.sh

    # Screenshot
    bindsym $mod+Shift+s exec grim && notify-send "took a screenshot"

include /etc/sway/config.d/*
